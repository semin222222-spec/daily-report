# ─────────────────────────────────────────────
# 삐딱 데일리 리포트 — 환경변수
# 로컬은 .env.local 로 복사해서 채우고,
# Vercel은 Project Settings → Environment Variables 에 동일하게 등록한다.
# ─────────────────────────────────────────────

# Supabase 프로젝트 URL (Dashboard → Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon(public) 키 — 브라우저에 노출되며 RLS로 보호된다
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role 키 — 절대 클라이언트에 노출 금지.
# 시드 스크립트(계정 생성)와 /api/reviews 수집에만 사용한다.
SUPABASE_SERVICE_ROLE_KEY=

# POST /api/reviews 호출용 공유 시크릿.
# 추후 붙일 리뷰 크롤러가 x-ingest-secret 헤더로 이 값을 보낸다.
# 아무 랜덤 문자열이면 된다: openssl rand -hex 24
REVIEW_INGEST_SECRET=

# 아이디 로그인용 합성 이메일 도메인.
# 점장은 "bbiddak" 처럼 아이디만 입력하고, 내부적으로 bbiddak@<도메인> 으로 인증한다.
NEXT_PUBLIC_LOGIN_EMAIL_DOMAIN=bbiddak.com
